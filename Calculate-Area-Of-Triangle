import java.util.*;
public class AreaOfRectangle {
    static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.println("enter the length : ");
        int l = sc.nextInt();
        System.out.println("enter the breath : ");
        int b = sc.nextInt();
        System.out.println("press 1 to know the Area \nPress 2 to know the Perimeter \nPress 3 to know the both ");
        int ch = sc.nextInt();
        double result1 = 0;
        double result2 = 0;
        switch (ch){
            case 1:
                result1 = l*b;
                System.out.println("Area : "+result1);
                break;
            case 2:
                result2 = 2*(l+b);
                System.out.println("Perimeter : "+result2);
                break;
            case 3:
                result1 = l*b;
                result2 = 2*(l+b);
                System.out.println("Area : "+result1 +"\nPerimeter : "+result2);
                break;
            default:
                System.out.println("ERROR");
        }
    }
}
